# Backend and frontend
DATABASE_URL=postgres://water_meter:water_meter@localhost:5432/water_meter
APP_HOST=0.0.0.0
APP_PORT=8080
CLIENT_HOST=192.168.1.34
CLIENT_PORT=80
CLIENT_ORIGIN=http://192.168.1.34
API_URL=http://192.168.1.34/api/health
RUST_LOG=info,tower_http=info
# Optional for manual frontend runs against a non-default API base.
# VITE_API_BASE_URL=http://localhost:8080

# Shared Docker stack
POSTGRES_DB=water_meter
POSTGRES_USER=water_meter
POSTGRES_PASSWORD=water_meter
WATER_METER_NETWORK=water-meter_default
WATER_METER_SUBNET=172.28.0.0/16
SEED_DEMO_DATA=false
BACKUP_HOST_DIR=/tmp
BACKUP_WAIT_SECONDS=30

# Reader
READER_RUNTIME_DIR=../reader/runtime
READER_IMAGE_RETENTION_DAYS=30
READER_CONTROL_URL=http://host.docker.internal:8090/manual-read
READER_CAMERA_INDEX=0
READER_VIDEO_DEVICE=/dev/video0
READER_INTERVAL_SECONDS=180
READER_PROCESSED_PICTURES_DIR=/data/processed
READER_PERSIST_EVERY=10
READER_CROP_OUTPUT=/data/meter-crop.png
READER_CONTROL_BIND=0.0.0.0:8090
READER_X1=159
READER_Y1=331
READER_X2=565
READER_Y2=414
READER_PG_WRITE=true
READER_PG_SOURCE=reader-docker
READER_PG_ANOMALY_THRESHOLD=200
READER_OCR_APPEND_DIGIT=0
#OLLAMA_BASE_URL=http://host.docker.internal:11434
